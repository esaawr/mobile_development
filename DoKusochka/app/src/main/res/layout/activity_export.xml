<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFE0">

    <!-- Верхняя панель -->
    <RelativeLayout
        android:id="@+id/topPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="17dp"
        android:paddingHorizontal="16dp">

        <!-- Кнопка назад -->
        <ImageView
            android:id="@+id/backButton"
            android:layout_width="49dp"
            android:layout_height="49dp"
            android:src="@drawable/back_icon"
            android:rotation="180"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"/>

        <!-- Заголовок -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="ЭКСПОРТ ДАННЫХ"
            android:textColor="#363368"
            android:textSize="24sp"
            android:textStyle="bold" />

    </RelativeLayout>

    <!-- SCROLLVIEW ДЛЯ ПРОКРУТКИ -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topPanel"
        android:padding="16dp"
        android:scrollbars="vertical">

        <!-- Основная карточка -->
        <RelativeLayout
            android:id="@+id/mainCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/rounded_orange_lightt"
            android:padding="20dp">

            <!-- Выбор данных -->
            <TextView
                android:id="@+id/selectDataText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ВЫБЕРИТЕ ДАННЫЕ ДЛЯ ЭКСПОРТА:"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#363368"
                android:layout_marginBottom="15dp" />

            <!-- Клиенты -->
            <LinearLayout
                android:id="@+id/clientsCheckboxContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_below="@id/selectDataText"
                android:layout_marginTop="15dp"
                android:padding="10dp"
                android:background="@drawable/rounded_white_small"
                android:clickable="true"
                android:focusable="true">

                <CheckBox
                    android:id="@+id/exportClientsCheckbox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="15dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Клиенты"
                    android:textSize="18sp"
                    android:textColor="#363368"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Заказы -->
            <LinearLayout
                android:id="@+id/ordersCheckboxContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_below="@id/clientsCheckboxContainer"
                android:layout_marginTop="15dp"
                android:padding="10dp"
                android:background="@drawable/rounded_white_small"
                android:clickable="true"
                android:focusable="true">

                <CheckBox
                    android:id="@+id/exportOrdersCheckbox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="15dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Заказы"
                    android:textSize="18sp"
                    android:textColor="#363368"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Меню -->
            <LinearLayout
                android:id="@+id/menuCheckboxContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_below="@id/ordersCheckboxContainer"
                android:layout_marginTop="15dp"
                android:padding="10dp"
                android:background="@drawable/rounded_white_small"
                android:clickable="true"
                android:focusable="true">

                <CheckBox
                    android:id="@+id/exportMenuCheckbox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="15dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Меню (пиццы)"
                    android:textSize="18sp"
                    android:textColor="#363368"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Статистика -->
            <LinearLayout
                android:id="@+id/statisticsCheckboxContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_below="@id/menuCheckboxContainer"
                android:layout_marginTop="15dp"
                android:padding="10dp"
                android:background="@drawable/rounded_white_small"
                android:clickable="true"
                android:focusable="true">

                <CheckBox
                    android:id="@+id/exportStatisticsCheckbox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="15dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Статистика"
                    android:textSize="18sp"
                    android:textColor="#363368"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Кнопка экспорта -->
            <LinearLayout
                android:id="@+id/exportButton"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_below="@id/statisticsCheckboxContainer"
                android:layout_marginTop="30dp"
                android:background="@drawable/button_background"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ЭКСПОРТИРОВАТЬ В CSV"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Прогресс бар -->
            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/exportButton"
                android:layout_marginTop="25dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/progressText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/progressBar"
                android:layout_marginTop="10dp"
                android:textAlignment="center"
                android:textSize="16sp"
                android:textColor="#363368"
                android:visibility="gone" />

            <!-- Результат (карточка) -->
            <LinearLayout
                android:id="@+id/resultLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_below="@id/progressText"
                android:layout_marginTop="25dp"
                android:background="@drawable/rounded_white"
                android:padding="20dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/resultText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textColor="#363368"
                    android:lineSpacingExtra="4dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp"
                    android:weightSum="2">

                    <!-- Кнопка открыть -->
                    <LinearLayout
                        android:id="@+id/openButton"
                        android:layout_width="0dp"
                        android:layout_height="45dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/rounded_blue"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ОТКРЫТЬ"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <!-- Кнопка поделиться -->
                    <LinearLayout
                        android:id="@+id/shareButton"
                        android:layout_width="0dp"
                        android:layout_height="45dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/dark_button_background"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ПОДЕЛИТЬСЯ"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- НИЖНИЙ ОТСТУП для ScrollView -->
            <View
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_below="@id/resultLayout"
                android:layout_marginTop="20dp" />

        </RelativeLayout>
    </ScrollView>

</RelativeLayout>