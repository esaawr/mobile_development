<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#fdd9b5"
    android:padding="16dp">

    <!-- Верхняя панель -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="17dp">

        <!-- Иконка меню -->
        <ImageView
            android:id="@+id/menuIcon"
            android:layout_width="68dp"
            android:layout_height="61dp"
            android:layout_alignParentStart="true"
            android:src="@drawable/menu_icon" />

        <!-- Иконка корзины -->
        <ImageView
            android:id="@+id/cartIcon"
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:layout_alignParentEnd="true"
            android:src="@drawable/cart_icon" />
        <TextView
            android:id="@+id/cartBadge"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignTop="@id/cartIcon"
            android:layout_alignEnd="@id/cartIcon"
            android:layout_marginTop="-8dp"
            android:layout_marginEnd="-8dp"
            android:background="@drawable/rounded_orange_mediumm"
            android:gravity="center"
            android:text="0"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:visibility="gone" />

    </RelativeLayout>


    <!-- Основная карточка -->
    <RelativeLayout
        android:id="@+id/mainCard"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="80dp"
        android:background="@drawable/rounded_orange_lightt"
        android:padding="16dp">

        <!-- Вкладки -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:gravity="center_horizontal"
            android:orientation="horizontal">

            <!-- СНЕКИ -->
            <RelativeLayout
                android:id="@+id/snacksTab"
                android:layout_width="92dp"
                android:layout_height="39dp"
                android:layout_marginEnd="23dp"
                android:background="@drawable/rounded_orange_mediumm"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="ЗАКУСКИ"
                    android:textColor="#ffcabd"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </RelativeLayout>

            <!-- ПИЦЦА -->
            <RelativeLayout
                android:layout_width="92dp"
                android:layout_height="39dp"
                android:layout_marginEnd="23dp"
                android:background="@drawable/rounded_orange_mediumm">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="ПИЦЦА"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </RelativeLayout>

            <!-- НАПИТКИ -->
            <RelativeLayout
                android:id="@+id/drinksTab"
                android:layout_width="100dp"
                android:layout_height="36dp"
                android:background="@drawable/rounded_orange_mediumm"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="НАПИТКИ"
                    android:textColor="#ffcabd"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </RelativeLayout>

        </LinearLayout>

        <ScrollView
            android:id="@+id/pizzasScrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="80dp">

            <LinearLayout
                android:id="@+id/pizzasContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="30dp">

                <!-- Пиццы будут добавляться динамически здесь -->

            </LinearLayout>

        </ScrollView>

    </RelativeLayout>

</RelativeLayout>